OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini

ELEVENLABS_API_KEY=your_elevenlabs_key
DEEPGRAM_API_KEY=your_deepgram_key

TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER2=+15555550100

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_SIP_URI=sip:your-project.sip.livekit.cloud

# Must match the SIP auth configured in your LiveKit inbound trunk + TwiML <Sip>.
LIVEKIT_INBOUND_TRUNK_USERNAME=trunk_user
LIVEKIT_INBOUND_TRUNK_PASSWORD=trunk_password

# Public HTTPS URL Twilio uses for your webhook, for signature validation.
PUBLIC_WEBHOOK_BASE_URL=https://your-webhook-domain.example
ENABLE_TWILIO_SIGNATURE_VALIDATION=true

SYSTEM_PROMPT=You are a concise phone assistant.
